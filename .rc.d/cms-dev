#!/usr/bin/env bash
# cms-dev — spin up a local, auth-free CMS to eyeball the render path in a real browser.
#
# Why this exists: every fork change's last step is "verify the real render path in a real
# browser" — unit tests miss it (the 0.170.6 prod crash passed 6901 tests). Sveltia's dev
# harness normally expects your *site* to run separately on :5174 and serve /admin/config.yml
# (see DEV_SITE_URL in src/lib/services/config/index.js). This collapses that onto one Vite
# server: it points VITE_SITE_URL back at itself and drops a throwaway `test-repo` config at
# public/admin/config.yml — no GitHub, no auth, no musictide checkout needed.
#
# Usage: cms-dev [port]      # default 5178; Ctrl-C to stop.
# Then:  open the printed URL → "Work with Test Repository" → Posts → + (new entry).
#
# The config is regenerated each run and is throwaway (public/ is git-ignored). Edit the heredoc
# below to exercise a different widget/layout you're verifying.
set -euo pipefail
cd "$(dirname "$0")/.." || exit 1   # fork root, regardless of caller cwd

PORT="${1:-5178}"
CONFIG=public/admin/config.yml

mkdir -p "$(dirname "$CONFIG")"
cat > "$CONFIG" <<'YAML'
# Throwaway harness config (test-repo backend = no auth, all client-side). Regenerated by cms-dev.
# Exercises the surfaces most fork patches touch: i18n locales, a relation combo, a dropdown-select
# combo (>5 options so it isn't radio-rendered), a hint/description, draft, and markdown.
backend:
  name: test-repo
media_folder: static/images
public_folder: /images
i18n:
  structure: multiple_files
  locales: [en, pt]
  default_locale: en
collections:
  - name: categories
    label: Categories
    folder: content/categories
    create: true
    slug: '{{slug}}'
    fields:
      - { name: title, widget: string }
  - name: posts
    label: Posts
    folder: content/posts
    create: true
    slug: '{{slug}}'
    i18n: true
    fields:
      - { name: title, label: Title, widget: string, i18n: true }
      - { name: category, label: Category, widget: relation, collection: categories, value_field: title, display_fields: [title], search_fields: [title] }
      - { name: featured_tag, label: Featured tag, widget: select, hint: Pick one tag to feature, options: [Rock, Metal, Jazz, Fado, Indie, Punk] }
      - { name: body, label: Body, widget: markdown, i18n: true }
YAML

echo "cms-dev → http://localhost:$PORT/   ('Work with Test Repository' → Posts → +)"
exec env VITE_SITE_URL="http://localhost:$PORT" pnpm dev --port "$PORT" --strictPort
